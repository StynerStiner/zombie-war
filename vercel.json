{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash build_vercel.sh",
  "outputDirectory": "zombie-war-web",
  "framework": null,
  "installCommand": "echo 'no npm dependencies - this is a Python project'",
  "github": {
    "silent": false
  },
  "headers": [
    {
      "source": "/cdn/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(zombiewar.apk|zombiewar.tar.gz|index.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
